# ==============================================================================
# Banglanews24 Backend Configuration (.env)
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=5000
APP_NAME=Banglanews24-API
BASE_URL=https://yourdomain.com

# MySQL Database Configuration (cPanel / Local MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cpaneluser_newsuser
DB_PASSWORD=SecurePassword@2026
DB_NAME=cpaneluser_banglanews
DB_CONNECTION_LIMIT=20
DB_WAIT_FOR_CONNECTIONS=true
DB_QUEUE_LIMIT=0

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_banglanews_production_2026
JWT_EXPIRES_IN=7d

# File Upload Directory (Relative or Absolute path on server)
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880 # 5MB in bytes
